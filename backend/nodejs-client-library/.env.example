# Location Service Configuration
LOCATION_API_URL=https://api.yourdomain.com
LOCATION_CLIENT_ID=your_client_id_here
LOCATION_CLIENT_SECRET=your_client_secret_here
# The Origin sent when a request to this server carries none (curl, a job).
# It must match the application's allowed domain.
LOCATION_ORIGIN=https://example.com

# Server Configuration
PORT=3000
