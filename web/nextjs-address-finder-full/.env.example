# ---- Server side (never reaches the browser) -------------------------------
# The API base URL (the endpoint shown for your application) and the
# APPLICATION's client credentials, created in the portal. The server action
# exchanges them for a short-lived bearer token.
LOCATION_API_URL=https://api.yourdomain.com
LOCATION_CLIENT_ID=your_client_id_here
LOCATION_CLIENT_SECRET=your_client_secret_here

# ---- Browser side ----------------------------------------------------------
# The same API base URL, used by MapLibre for style/tile/glyph/sprite requests
# and by the static-map fetch. The bearer token is attached per request; the
# credentials above never leave the server.
NEXT_PUBLIC_LOCATION_API_URL=https://api.yourdomain.com

# ---- Optional ----------------------------------------------------------------
# Origin sent by the server-side playground when the incoming request has none
# (e.g. curl). Must match the application's allowed domain in the portal.
# LOCATION_ALLOWED_ORIGIN=http://localhost:3001
