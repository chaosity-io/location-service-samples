# Location Service Configuration
# The API endpoint shown for your application, and its client credentials.
# These three stay on the server: a server action exchanges the credentials
# for a short-lived token.
LOCATION_API_URL=https://api.yourdomain.com
LOCATION_CLIENT_ID=your_client_id_here
LOCATION_CLIENT_SECRET=your_client_secret_here

# The same endpoint again, for the browser: the map requests its style, tiles,
# glyphs and sprites from it. Without it the map asks this app for
# /undefined/maps/… and draws nothing.
NEXT_PUBLIC_LOCATION_API_URL=https://api.yourdomain.com
